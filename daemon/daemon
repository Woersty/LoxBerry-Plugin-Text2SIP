#!/bin/bash
### BEGIN INIT INFO
# Provides:          Text2SIP-Plugin
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Configure Text2SIP runtime and manage resident Pocket-TTS.
# Description:       Idempotent runtime setup plus detached local Pocket-TTS server.
### END INIT INFO

PATH="/sbin:/bin:/usr/sbin:/usr/bin"

logfile="REPLACELBHOMEDIR/log/plugins/text2sip/Text2SIP.log"
configdir="REPLACELBHOMEDIR/config/plugins/text2sip"
configfile="$configdir/Text2SIP.cfg"
flagfile="$configdir/modify.me"
ramfolder="/run/shm/text2sip"
pocketram="/run/shm/text2sip-pockettts"
serverctl="REPLACELBHOMEDIR/bin/plugins/text2sip/pockettts/pockettts_server.sh"
watchdogctl="REPLACELBHOMEDIR/bin/plugins/text2sip/pockettts/pockettts_watchdog.sh"

dlog() {
    mkdir -p "$(dirname "$logfile")" 2>/dev/null || true
    printf '%s %s\n' "$(date '+%b %e %H:%M:%S')" "$*" >> "$logfile" 2>/dev/null || true
}

runtime_setup() {
    mkdir -p "$(dirname "$logfile")" "$configdir" "$ramfolder" "$pocketram"
    touch "$logfile"
    chown loxberry:loxberry "$logfile" "$ramfolder" "$pocketram" 2>/dev/null || true
    chmod 660 "$logfile" 2>/dev/null || true
    chmod 775 "$ramfolder" "$pocketram" 2>/dev/null || true

    if [ -f "$configfile" ]; then
        chown loxberry:loxberry "$configfile" 2>/dev/null || true
        chmod 664 "$configfile" 2>/dev/null || true
    fi

    if [ -r "$flagfile" ]; then
        dlog "modify.me found. Applying Text2SIP runtime setup."
        rm -f "$flagfile"
        dlog "Text2SIP runtime setup completed."
    fi
}

server_start() {
    [ -x "$serverctl" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$serverctl" start >> "$logfile" 2>&1 || return $?
    else
        "$serverctl" start >> "$logfile" 2>&1 || return $?
    fi
}

server_stop() {
    [ -x "$serverctl" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$serverctl" stop >> "$logfile" 2>&1 || return $?
    else
        "$serverctl" stop >> "$logfile" 2>&1 || return $?
    fi
}

server_status() {
    [ -x "$serverctl" ] || { echo "Pocket-TTS controller unavailable"; return 1; }
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$serverctl" status
    else
        "$serverctl" status
    fi
}

watchdog_start() {
    [ -x "$watchdogctl" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$watchdogctl" start >> "$logfile" 2>&1 || return $?
    else
        "$watchdogctl" start >> "$logfile" 2>&1 || return $?
    fi
}

watchdog_stop() {
    [ -x "$watchdogctl" ] || return 0
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$watchdogctl" stop >> "$logfile" 2>&1 || return $?
    else
        "$watchdogctl" stop >> "$logfile" 2>&1 || return $?
    fi
}

watchdog_status() {
    [ -x "$watchdogctl" ] || { echo "Pocket-TTS watchdog unavailable"; return 1; }
    if [ "$(id -u)" -eq 0 ]; then
        runuser -u loxberry -- "$watchdogctl" status
    else
        "$watchdogctl" status
    fi
}

# LoxBerry historically invokes plugin daemon scripts without arguments, so an
# empty action remains equivalent to "start". Explicit stop/restart/status are
# handled correctly for service management and shutdown.
action="${1:-start}"
case "$action" in
    start)
        runtime_setup
        server_start
        server_rc=$?
        watchdog_start || true
        exit $server_rc
        ;;
    stop)
        watchdog_stop || true
        server_stop
        exit $?
        ;;
    restart)
        watchdog_stop || true
        server_stop || true
        runtime_setup
        server_start
        server_rc=$?
        watchdog_start || true
        exit $server_rc
        ;;
    status)
        server_status
        server_rc=$?
        watchdog_status
        watchdog_rc=$?
        [ "$server_rc" -eq 0 ] && [ "$watchdog_rc" -eq 0 ]
        exit $?
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 64
        ;;
esac
