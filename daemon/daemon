#!/bin/bash
### BEGIN INIT INFO
# Provides:          Text2SIP-Plugin
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Configure the LoxBerry Text2SIP plugin runtime files.
# Description:       Idempotent runtime-directory and permission setup.
### END INIT INFO

PATH="/sbin:/bin:/usr/sbin:/usr/bin"

logfile="REPLACELBHOMEDIR/log/plugins/text2sip/Text2SIP.log"
configdir="REPLACELBHOMEDIR/config/plugins/text2sip"
configfile="$configdir/Text2SIP.cfg"
flagfile="$configdir/modify.me"
datafolder="REPLACELBHOMEDIR/data/plugins/text2sip"
wavfolder="$datafolder/wav"

mkdir -p "$(dirname "$logfile")" "$configdir" "$wavfolder"
touch "$logfile"
chown loxberry:loxberry "$logfile" "$wavfolder" 2>/dev/null || true
chmod 660 "$logfile" 2>/dev/null || true
chmod 755 "$wavfolder" 2>/dev/null || true

if [ -f "$configfile" ]; then
    chown loxberry:loxberry "$configfile" 2>/dev/null || true
    chmod 664 "$configfile" 2>/dev/null || true
fi

if [ -r "$flagfile" ]; then
    echo "$(date '+%b %e %H:%M:%S') modify.me found. Applying Text2SIP runtime setup." >> "$logfile"
    rm -f "$flagfile"
    echo "$(date '+%b %e %H:%M:%S') Text2SIP runtime setup completed." >> "$logfile"
fi

exit 0
